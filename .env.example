# Copy to .env (or export these in your shell). Never commit a real key.
# Get a free key at https://the-odds-api.com/ — 500 credits/month, no card.
ODDS_API_KEY=

# Minimum edge to flag a play, in probability points. 0.03 = 3%.
MIN_EDGE=0.03

# Player props: how many upcoming events per sport to fetch props for.
# 3 = on for NBA only (see PROP_SPORTS). Props cost more credits per
# event, so keep this small.
PROP_EVENTS=3

# Which sports get player props (Odds API sport keys, comma-separated).
# NBA only by default — add basketball_ncaab or americanfootball_nfl
# to include them (each extra sport costs more credits).
PROP_SPORTS=basketball_nba

# How often the live site re-scans on its own, in hours. Default 48:
# a full scan costs about 27 credits, so daily (24) is about 810/month
# and does NOT fit the free 500 credits/month. Every other day (48)
# is about 405/month and fits. Set to 24 for daily, 0 to only refresh
# on the Refresh button.
AUTO_REFRESH_HOURS=48
